# Copy to .env and fill in keys. .env is gitignored; never commit real keys.
# Default model profile: offline | 9router | lmstudio
LLM_PROFILE=offline

NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-your-9router-key
NINEROUTER_MODEL=demo
# (9router combo "demo"; the id "combo:demo" returns 404)
# Gateway fallback (and quarantine small model) for 9router: lmstudio
NINEROUTER_FALLBACK_PROFILE=lmstudio

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=sk-lm-your-lmstudio-key
LMSTUDIO_MODEL=qwen/qwen3-4b
